generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DemoMessage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
